      },
      "level_2": {
        "component": "identify-and-tap",
        "title": "Shapes & Colors",
        "items": [
          { "shape": "circle", "color": "red", "basket_options": ["red", "blue"], "image": "assets/img/red_circle.png" },
          { "shape": "square", "color": "blue", "basket_options": ["blue", "yellow"], "image": "assets/img/blue_square.png" },
          { "shape": "triangle", "color": "yellow", "basket_options": ["yellow", "red"], "image": "assets/img/yellow_triangle.png" }
        ]
      },
      "level_3": {
        "component": "two-choice-tap",
        "title": "Big vs Small",
        "note": "For dog/cat/car/duck, render the SAME image at two different display sizes in code instead of using separate big/small image files.",
        "items": [
          { "object": "elephant", "big_image": "assets/img/elephant_big.png", "small_image": "assets/img/elephant_small.png", "audio_prompt": "assets/audio/en/tap_big_elephant.mp3" },
          { "object": "ball", "big_image": "assets/img/ball_big.png", "small_image": "assets/img/ball_small.png", "audio_prompt": "assets/audio/en/tap_big_ball.mp3" },
          { "object": "dog", "image": "assets/img/dog.png", "render_sizes_in_code": true, "audio_prompt": "assets/audio/en/tap_big_dog.mp3" },
          { "object": "cat", "image": "assets/img/cat.png", "render_sizes_in_code": true, "audio_prompt": "assets/audio/en/tap_big_cat.mp3" },
          { "object": "car", "image": "assets/img/car.png", "render_sizes_in_code": true, "audio_prompt": "assets/audio/en/tap_big_car.mp3" },
          { "object": "duck", "image": "assets/img/duck.png", "render_sizes_in_code": true, "audio_prompt": "assets/audio/en/tap_big_duck.mp3" }
        ]
