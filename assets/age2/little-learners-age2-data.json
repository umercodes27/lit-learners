    "math": {
      "level_1": {
        "component": "tap-to-count",
        "title": "Counting 1 to 5",
        "items": [
          { "object_image": "assets/img/star.png", "count": 3, "audio_numbers": ["assets/audio/num/1.mp3", "assets/audio/num/2.mp3", "assets/audio/num/3.mp3"] },
          { "object_image": "assets/img/ball_red.png", "count": 5, "audio_numbers": ["assets/audio/num/1.mp3", "assets/audio/num/2.mp3", "assets/audio/num/3.mp3", "assets/audio/num/4.mp3", "assets/audio/num/5.mp3"] }
